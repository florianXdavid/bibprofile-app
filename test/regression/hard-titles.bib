% BibProfile v1.4.1 — title-matching regression set ("hard" entries).
%
% None of these entries has a `doi` field, so every one goes through the title
% search + multi-signal scoring path. Ground truth lives in custom fields that
% BibProfile itself ignores:
%   expectdoi = {…}  the correct record is the OpenAlex work at this DOI
%                    (resolved to its OpenAlex ID when the fixture is recorded)
%   expectid  = {W…} the correct OpenAlex ID, set by hand after review (no usable
%                    DOI); `W1 | W2` = OpenAlex holds the same work twice, either is right.
%                    The reason is recorded in `note`.
%   expectnot = {…}  a DOI this entry must NEVER be confidently matched to
%   expect    = {none}   no confident match is acceptable (fabricated entries)
%   retraction = {retracted}  v1.4.2: the reference must be reported as retracted
%                    (every entry WITHOUT it must NOT be reported as retracted)
%   hardcase  = {…}  category: retracted | book-article | preprint-proceedings |
%                    republished | non-english | generic | negative
%
% Rule checked on every test run: a confident `matched-by-title` must never be
% the wrong record. Being `uncertain` or `not-found` on a hard entry is allowed
% and counted (recall), not failed.
%
% ======================================================================== v1.5
% v1.5 adds sections built from an audit of 6 real-world .bib files (587 entries)
% and a probe run of the cleaned .bib. UNLIKE the sections above, the v1.5
% sections (marked "v1.5" in their divider) deliberately contain `doi`, `url`,
% `eprint`, `note`/`howpublished` identifiers, `@misc` resources, an empty entry,
% a duplicate cite key and a stray closing brace — the bugs they guard against
% live in those paths. If the harness assumes "title path only", run the v1.5
% hardcase categories as a separate group. Parser-robustness entries are placed
% LAST on purpose so a parser regression cannot hide failures elsewhere.
%
% Six pre-existing entries received ONE extra v1.5 field each, plus an `auditnote`
% field explaining why (nothing else changed):
%   devlin2018arxiv (expectdup), krizhevsky2012nips (expectnotid),
%   kingma2014 (expectpublishednot), vaswani2017 (expectrecencyyear),
%   heisenberg1927 (expectnosuggest), einstein1905sr (expecttitle).
%
% New ground-truth fields (BibProfile ignores them; the harness reads them):
%   expectstatus      = {s1 | s2}  row status must be one of these
%   expectmax         = {uncertain}  must never be a confident match
%                       (matched-by-doi / matched-by-title)
%   expectlookup      = {doi:… | arxiv:… | pmid:…}  identifier the tool must extract
%                       (from url / note / howpublished / eprint / journal) and resolve
%                       for free — no billable title search for this entry
%   expectnotid       = {W…}  must never be CONFIDENTLY matched to this record
%   expectdup         = {key}  must be reported as the same OpenAlex work as `key`
%                       ("Duplicate of" = key, or key's row points here)
%   expectnotdup      = {key}  must NOT be collapsed into `key`, even if they share a DOI
%   expectfill        = {field=value}  cleaned .bib must contain exactly `field = {value}`
%   expectnosuggest   = {f1,f2 | *}  no fill and no "differs" review item for these fields
%                       (`*` = no suggestion of any kind for this entry)
%   expectversion     = {preprint}  match is to a preprint record and must be labelled so
%   expectrecencyyear = {YYYY}  year the Recency card must use for this reference
%   expectyear        = {YYYY}  year the parser must read for this entry
%   expecttitle       = {…}  Title (.bib) column must contain this substring
%   expecttitlenot    = {…}  Title (.bib) column must NOT contain this substring
%   expectpublishednot = {doi}  Preprint→published must never suggest this DOI
%   expecterror       = {empty-entry | duplicate-key}  parse-level error to report
%   auditnote         = {…}  human note: which audit finding the entry covers
%                       (IDs refer to bibprofile-patch-issues.md)
%
% Global invariants (checked on the whole run, v1.5):
%   G1  every value written to or proposed for the cleaned .bib escapes LaTeX
%       specials: & % $ # _  (e.g. `\&`), never a bare `&`
%   G2  no written/proposed venue matches
%       /\/Proceedings - |^PubMed$| eBooks$|^Medical Entomology and Zoology$/
%   G3  an entry with status `suspicious` receives no fills and no differs items
%   G4  no two CONFIDENT rows share an OpenAlex ID unless one row's
%       "Duplicate of" points to the other
%   G5  pages are never written as a degenerate range `N--N`
%
% Some expectid values in v1.5 come from DOI resolution in the audit (reliable);
% the two marked "verify" come from current title-match output and should be
% confirmed by hand before the fixture is recorded.

