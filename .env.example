# ---------------------------------------------------------------------------
# BibProfile configuration (Vite reads VITE_* vars into import.meta.env).
# Copy this file to `.env` for LOCAL dev. `.env` is gitignored.
#
# WARNING: any VITE_* var is embedded into the client bundle at build time.
# Stage 3 (now): the SHARED path goes through the `bibprofile-worker` proxy, which
# holds the OpenAlex key server-side. So the DEPLOYED build points the base URL at
# the Worker and leaves the key BLANK — the shared key must never be in the client
# bundle again. The user-key path always talks to OpenAlex directly (see config.ts).
# ---------------------------------------------------------------------------

# The SHARED path's network target.
#   • Deployed (Cloudflare Pages): the Worker proxy URL (it injects the key server-side):
#       https://bibprofile-worker.florian-david-9111.workers.dev
#   • Local dev: leave as api.openalex.org to hit OpenAlex directly (with your own
#     key below), or set it to the Worker URL to mirror production.
VITE_OPENALEX_BASE_URL=https://api.openalex.org

# OpenAlex API key. LEAVE BLANK on the deployed shared build — the Worker holds it,
# so nothing is shipped to the browser. For LOCAL direct dev you may put your own
# free key here (https://openalex.org/settings/api). Never commit a real key.
VITE_OPENALEX_API_KEY=

# Optional politeness contact. Not required (OpenAlex gates on the key); harmless.
VITE_OPENALEX_MAILTO=
