# ---------------------------------------------------------------------------
# BibProfile local configuration (Vite reads VITE_* vars into import.meta.env)
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# WARNING: any VITE_* var is embedded into the client bundle at build time.
# This is fine for W1 (you run it locally with your own key). Do NOT deploy a
# build that contains your key. In W2 you will leave VITE_OPENALEX_API_KEY
# blank and point VITE_OPENALEX_BASE_URL at a Cloudflare Worker that injects
# the key server-side. See src/config.ts and the README.
# ---------------------------------------------------------------------------

# The ONE network target for the whole app. Default is OpenAlex directly.
# In W2, change this to your Worker proxy URL (e.g. https://bibprofile-proxy.you.workers.dev).
VITE_OPENALEX_BASE_URL=https://api.openalex.org

# Your free OpenAlex API key (get one at https://openalex.org/settings/api).
# W1 / local only. Leave blank in W2 (the proxy holds the key).
VITE_OPENALEX_API_KEY=

# Optional politeness contact. OpenAlex now gates rate limits on the API key,
# so this is not required, but it is harmless and still accepted.
VITE_OPENALEX_MAILTO=
